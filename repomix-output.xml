  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

/* ───────────────────────────────────────────────────────────────────────
   AetherRun theme — refined charcoal + violet.
   Inspired by Linear / Vercel dashboard / GitHub Codespaces.

   Palette rationale:
   - Background is a near-black with a faint warm-violet undertone (L=0.13).
     This reads as "intentional dark", not "default slate".
   - Surface elevation comes from L=0.16 (card) and L=0.18 (popover), a
     subtle 1–2 step gradient instead of jarring panel boundaries.
   - Single accent: violet (#8b5cf6 / oklch 0.62 0.19 295). Used for
     primary actions, active tabs, focus rings, selected rows.
   - Verdict colors remain semantic (green/red/orange/purple/pink), driven
     by STATUS_COLORS in @/domain/enums — they are never used as the UI
     primary accent, only for status communication.
   - Borders are deliberately subtle (L=0.22) so panels read as surfaces
     rather than as bordered boxes.
   ─────────────────────────────────────────────────────────────────────── */
:root {
  --radius: 0.5rem;

  /* Surfaces */
  --background: oklch(0.13 0.004 285);
  --foreground: oklch(0.96 0.004 60);   /* warm off-white */

  --card: oklch(0.16 0.004 285);
  --card-foreground: oklch(0.96 0.004 60);
  --popover: oklch(0.17 0.005 285);
  --popover-foreground: oklch(0.96 0.004 60);

  /* Accent (single, confident) */
  --primary: oklch(0.62 0.19 295);
  --primary-foreground: oklch(0.99 0 0);

  /* Neutral surfaces */
  --secondary: oklch(0.19 0.005 285);
  --secondary-foreground: oklch(0.96 0.004 60);
  --muted: oklch(0.18 0.004 285);
  --muted-foreground: oklch(0.62 0.012 285);

  /* Accent hover surface — tinted with primary for subtle violet glow */
  --accent: oklch(0.21 0.012 295);
  --accent-foreground: oklch(0.96 0.004 60);

  --destructive: oklch(0.62 0.20 25);

  /* Subtle borders — readable but quiet */
  --border: oklch(0.24 0.006 285);
  --input: oklch(0.20 0.005 285);
  --ring: oklch(0.62 0.19 295 / 0.55);

  /* Verdict chart palette (kept semantic, tuned for the dark surface) */
  --chart-1: oklch(0.74 0.16 155);  /* ACCEPTED — emerald */
  --chart-2: oklch(0.66 0.22 25);   /* WRONG/FAILED — red */
  --chart-3: oklch(0.75 0.16 65);   /* TLE — orange */
  --chart-4: oklch(0.66 0.19 295);  /* MLE — violet */
  --chart-5: oklch(0.70 0.18 350);  /* RTE — pink */

  /* Sidebar is a touch darker than the main bg for separation */
  --sidebar: oklch(0.115 0.004 285);
  --sidebar-foreground: oklch(0.96 0.004 60);
  --sidebar-primary: oklch(0.62 0.19 295);
  --sidebar-primary-foreground: oklch(0.99 0 0);
  --sidebar-accent: oklch(0.21 0.012 295);
  --sidebar-accent-foreground: oklch(0.96 0.004 60);
  --sidebar-border: oklch(0.24 0.006 285);
  --sidebar-ring: oklch(0.62 0.19 295 / 0.55);
}

.dark {
  /* Default to dark — same values as :root. */
  --background: oklch(0.13 0.004 285);
  --foreground: oklch(0.96 0.004 60);
  --card: oklch(0.16 0.004 285);
  --card-foreground: oklch(0.96 0.004 60);
  --popover: oklch(0.17 0.005 285);
  --popover-foreground: oklch(0.96 0.004 60);
  --primary: oklch(0.62 0.19 295);
  --primary-foreground: oklch(0.99 0 0);
  --secondary: oklch(0.19 0.005 285);
  --secondary-foreground: oklch(0.96 0.004 60);
  --muted: oklch(0.18 0.004 285);
  --muted-foreground: oklch(0.62 0.012 285);
  --accent: oklch(0.21 0.012 295);
  --accent-foreground: oklch(0.96 0.004 60);
  --destructive: oklch(0.62 0.20 25);
  --border: oklch(0.24 0.006 285);
  --input: oklch(0.20 0.005 285);
  --ring: oklch(0.62 0.19 295 / 0.55);
  --chart-1: oklch(0.74 0.16 155);
  --chart-2: oklch(0.66 0.22 25);
  --chart-3: oklch(0.75 0.16 65);
  --chart-4: oklch(0.66 0.19 295);
  --chart-5: oklch(0.70 0.18 350);
  --sidebar: oklch(0.115 0.004 285);
  --sidebar-foreground: oklch(0.96 0.004 60);
  --sidebar-primary: oklch(0.62 0.19 295);
  --sidebar-primary-foreground: oklch(0.99 0 0);
  --sidebar-accent: oklch(0.21 0.012 295);
