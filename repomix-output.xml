    linear-gradient(to bottom, oklch(0.30 0.004 285 / 0.18) 1px, transparent 1px);
  background-size: 32px 32px;
}

/* Glow effects for active status banners — used very sparingly */
@utility glow-violet {
  box-shadow: 0 0 18px oklch(0.62 0.19 295 / 0.35);
}
@utility glow-emerald {
  box-shadow: 0 0 18px oklch(0.74 0.16 155 / 0.35);
}
@utility glow-red {
  box-shadow: 0 0 18px oklch(0.66 0.22 25 / 0.35);
}
@utility glow-amber {
  box-shadow: 0 0 18px oklch(0.75 0.16 65 / 0.35);
}

/* Pulsing dot for "live" indicators — scale + opacity, smooth */
@keyframes pulse-live {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(0.78); }
}
@utility animate-pulse-live {
